; Secretos y ajustes de entorno del Notificador de Releases.
; Copia este fichero como .env (NUNCA lo subas a git) y déjalo con permisos 600: chmod 600 .env
; La web solo LEE este fichero; cambiar un valor = editarlo aquí (por SSH en IONOS).

; --- Base de datos (MariaDB) -------------------------------------------------------------------
; Docker local: DB_HOST=mariadb (red dev_net). IONOS: el host que indica el panel (dbXXXXXXXX.hosting-data.io).
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

; --- Telegram ------------------------------------------------------------------------------------
; Desde v1.3.0 los avisos van a través del backend compartido del bot (proyecto telegram-bot), que tiene el
; webhook. Se da de alta en el bot con: cli/project.php add releases https://<subdominio>/api/bot.php
; URL del bot, sin barra final. Docker local: http://localhost/telegram-bot (vista desde dentro del contenedor).
BOT_BACKEND_URL=
; Clave que mostró «cli/project.php add» (una sola vez). Si se pierde: cli/project.php rotate-key releases
BOT_PROJECT_KEY=
; Opcional: nombre del proyecto en el bot si no es «releases».
; BOT_PROJECT=releases
; Respaldo: token del bot (@BotFather), solo si NO hay BOT_BACKEND_URL + BOT_PROJECT_KEY. Con el webhook del bot
; activo, «Detectar chat» no funciona con el token (Telegram responde 409). Bórralo cuando el bot funcione.
TELEGRAM_BOT_TOKEN=
; El chat donde avisar se elige en Configuración («Detectar chat»).

; --- GitHub ---------------------------------------------------------------------------------------
; Opcional. Token clásico; con el scope read:packages también consulta imágenes de ghcr.io.
GITHUB_TOKEN=

; --- Clave de cifrado ----------------------------------------------------------------------------
; APP_KEY cifra los secretos de la verificación en dos pasos (2FA). NO la escribas a mano: la genera y añade
; al final de este fichero «cli/migrate.php» si falta. Si se pierde o se cambia, el 2FA de todos deja de
; funcionar y hay que restablecerlo con «cli/user.php 2fa-reset <usuario>».
; APP_KEY=

; --- Entorno --------------------------------------------------------------------------------------
; PHP de consola para «Verificar» y el cron. Vacío = autodetectar (nunca elige un PHP < 8).
; IONOS: /usr/bin/php8.4-cli   (el comando «php» a secas allí es PHP 4.4)
PHP_CLI=
; Zona horaria de las fechas de la app. El servidor de IONOS está en America/New_York.
APP_TIMEZONE=America/Mexico_City
; Opcional: false desactiva la redirección automática a HTTPS (por defecto se fuerza fuera de localhost/IPs privadas).
; FORCE_HTTPS=false
; Opcional: false hace OPCIONAL el 2FA de los administradores. Solo para el Docker local; en IONOS no lo pongas
; (sin esta clave, o con cualquier otro valor, es obligatorio).
; REQUIRE_ADMIN_2FA=false
